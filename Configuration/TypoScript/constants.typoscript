# Let's define some constants for global configuration
ns_basetheme {
	website {
		settings {
			logo = fileadmin/ns_theme_freelancer/logo.png
			favicon = fileadmin/ns_theme_freelancer/favicon.ico
			logo_width = 242px
			logo_height = 50px
			main_menu = 10
			footer_menu = 7
			root = 1
			compress_cssjs = 1
			no_cache = 1
			back_to_top = 1
			copyright = T3Planet | <a href="https://www.nitsan.in"> NITSAN Technologies Pvt Ltd </a>
		}
	}
}

ns_theme_freelancer {	
	website {
		settings {
			#cat = ns_basetheme/110/04; type=int; label=Footer Content Id: Setup footer content-id of your footer Content
			footerContentId = 9
			
			#cat = ns_theme_freelancer/website/settings/01; type=string; label=Google analytics code
			googleanalytics = 123456789
		}
		paths {
			#cat = ns_theme_freelancer/website/settings/01; type=string; label=Template Path
			templateRootPath = EXT:ns_theme_freelancer/Resources/Private/Templates/

			#cat = ns_theme_freelancer/website/settings/02; type=string; label=Layouts Path
			layoutRootPath = EXT:ns_theme_freelancer/Resources/Private/Layouts/

			#cat = ns_theme_freelancer/website/settings/03; type=string; label=Partials Path
			partialRootPath = EXT:ns_theme_freelancer/Resources/Private/Partials/
		}
	}
}
